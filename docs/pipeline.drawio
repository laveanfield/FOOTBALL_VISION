<mxfile host="app.diagrams.net" modified="2026-10-05T00:00:00.000Z" agent="Claude" version="24.7.17" type="device">
  <diagram id="football-vision-pipeline" name="System Pipeline">
    <mxGraphModel dx="1100" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="920" pageHeight="1790" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Football Tactical Vision Analyzer — System Pipeline" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="840" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Football video → detection &amp;amp; tracking + pitch geometry → top-down tactical map → analytics, visualization and evaluation" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="840" height="22" as="geometry"/></mxCell>
        <mxCell id="input" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Input: Football Video&lt;/b&gt;&lt;/font&gt;&lt;br&gt;broadcast clip · fixed tactical camera · self-recorded footage" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="230" y="92" width="460" height="56" as="geometry"/></mxCell>
        <mxCell id="p1" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P1 · Data Preprocessing  [L1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Decode frames · resize to 1280×720 · color spaces (RGB / Gray / HSV / Lab) · denoise (Gaussian / bilateral) · CLAHE&lt;br&gt;Shot boundary detection (HSV histogram distance) · pitch (grass) mask: HSV threshold + morphology&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Out: frames · shot list · pitch mask&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="40" y="184" width="840" height="86" as="geometry"/></mxCell>
        <mxCell id="brA" value="BRANCH A · Pitch Geometry (classical CV)" style="swimlane;fontStyle=1;fontSize=13;startSize=32;horizontal=1;container=1;collapsible=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;swimlaneFillColor=#fffbea;fontColor=#1a1a1a;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="400" height="584" as="geometry"/></mxCell>
        <mxCell id="brB" value="BRANCH B · Object Analysis (deep learning)" style="swimlane;fontStyle=1;fontSize=13;startSize=32;horizontal=1;container=1;collapsible=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;swimlaneFillColor=#f7f1fa;fontColor=#1a1a1a;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="480" y="322" width="400" height="584" as="geometry"/></mxCell>
        <mxCell id="p2" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P2 · Line &amp;amp; Keypoint Extraction  [L1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Canny edges (σ, hysteresis) or white top-hat&lt;br&gt;• Hough lines in (ρ, θ) space · merge and cluster into two families&lt;br&gt;• Line intersections → candidate pitch keypoints&lt;br&gt;• Center circle is an ellipse under perspective (optional ellipse fit)&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: line / keypoint accuracy&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="brA"><mxGeometry x="44" y="46" width="332" height="146" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P4 · Object Detection  [L1]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• YOLO (COCO-pretrained, optional fine-tuning)&lt;br&gt;• Classes: person, sports ball · high-resolution inference (imgsz ≥ 960)&lt;br&gt;• Confidence / NMS / size filters · pitch-mask filtering (feet inside the pitch)&lt;br&gt;• Optional: tiling (SAHI) + interpolation for the ball&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: mAP@0.5 · mAP@0.5:0.95 · FPS&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="brB"><mxGeometry x="44" y="46" width="332" height="146" as="geometry"/></mxCell>
        <mxCell id="p3a" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P3a · Keyframe Homography  [L2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Pitch template 105 × 68 m (landmarks and lines)&lt;br&gt;• Semi-auto: click ≥ 4 landmarks · Auto: hypothesize-and-verify&lt;br&gt;• DLT + Hartley normalization + RANSAC + LM refinement&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: reprojection error (m) on held-out landmarks&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="brA"><mxGeometry x="44" y="224" width="332" height="146" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P5 · Multi-Object Tracking  [L2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• ByteTrack (two-stage association: high- and low-score boxes)&lt;br&gt;• Own SORT: Kalman filter + Hungarian assignment (for comparison)&lt;br&gt;• Tracklet stitching · image-space vs pitch-space tracking (uses H&lt;sub&gt;t&lt;/sub&gt;)&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: MOTA · IDF1 · HOTA · ID switches&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="brB"><mxGeometry x="44" y="224" width="332" height="146" as="geometry"/></mxCell>
        <mxCell id="p3b" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P3b · Temporal Alignment &amp;amp; Quality Control  [L2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Background features (ORB / SIFT / AKAZE), players masked out&lt;br&gt;• Frame-to-frame homography G&lt;sub&gt;t&lt;/sub&gt; (RANSAC): H&lt;sub&gt;t&lt;/sub&gt; = H&lt;sub&gt;t−1&lt;/sub&gt; · G&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;• Corner-point smoothing · validity flag · drift check (line-overlay score)&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: reprojection error · overlay score · jitter&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="brA"><mxGeometry x="44" y="402" width="332" height="164" as="geometry"/></mxCell>
        <mxCell id="p6" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P6 · Team &amp;amp; Role Classification  [L3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Torso crop → Lab / HSV color feature → KMeans (k = 2–4)&lt;br&gt;• Mask out grass pixels before clustering&lt;br&gt;• Per-track majority vote · roles: player / goalkeeper / referee&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: team accuracy · confusion matrix&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="brB"><mxGeometry x="44" y="402" width="332" height="164" as="geometry"/></mxCell>
        <mxCell id="p7" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P7 · Top-down Projection &amp;amp; Trajectory Smoothing  [L2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Foot point (bottom-center of bbox) → pitch coordinates in meters: p′ = π(H&lt;sub&gt;t&lt;/sub&gt; · p) · validity filter · Savitzky–Golay / Kalman smoothing&lt;br&gt;Assumption: the projected point lies on the ground plane (feet, not bbox center)&lt;br&gt;&lt;font color=&quot;#555555&quot;&gt;&lt;i&gt;Out: pitch_xy.csv (frame, track_id, X, Y, team, role, valid)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="40" y="958" width="840" height="86" as="geometry"/></mxCell>
        <mxCell id="a1" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Heatmap  [L2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• 2D histogram + Gaussian blur&lt;br&gt;• Normalized by visible time" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="40" y="1090" width="195" height="116" as="geometry"/></mxCell>
        <mxCell id="a2" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Trajectories &amp;amp; Team Shape  [L3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Trails per player&lt;br&gt;• Centroid · length L · width W&lt;br&gt;• Convex hull · stretch index" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="255" y="1090" width="195" height="116" as="geometry"/></mxCell>
        <mxCell id="a3" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Distance &amp;amp; Speed  [L3]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Computed after smoothing&lt;br&gt;• Speed zones&lt;br&gt;• Sanity check: v &amp;lt; 12 m/s&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;&lt;i&gt;Eval: speed distribution&lt;/i&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="470" y="1090" width="195" height="116" as="geometry"/></mxCell>
        <mxCell id="a4" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Possession &amp;amp; Passing Network  [L4 · optional]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Nearest player to the ball&lt;br&gt;• Pass detection · directed graph" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;dashed=1;dashPattern=8 4;" vertex="1" parent="1"><mxGeometry x="685" y="1090" width="195" height="116" as="geometry"/></mxCell>
        <mxCell id="p8" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;P8 · Visualization &amp;amp; Demo&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Side-by-side video (original + overlays | top-down map) · time filmstrip · report figures · failure gallery&lt;br&gt;Interactive demo (Streamlit / Gradio): toggle layers, time slider, key metrics" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="40" y="1252" width="840" height="68" as="geometry"/></mxCell>
        <mxCell id="p9" value="P9 · Evaluation &amp;amp; Optimization (covers every stage)" style="swimlane;fontStyle=1;fontSize=13;startSize=32;horizontal=1;container=1;collapsible=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#fafafa;fontColor=#1a1a1a;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1376" width="600" height="172" as="geometry"/></mxCell>
        <mxCell id="p9_gt" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Ground Truth (CVAT)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• Detection boxes (100–200 frames)&lt;br&gt;• Held-out homography landmarks&lt;br&gt;• MOT tracks (10–20 s)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="p9"><mxGeometry x="14" y="44" width="184" height="114" as="geometry"/></mxCell>
        <mxCell id="p9_met" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Metrics &amp;amp; Ablations&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• mAP · MOTA / IDF1 / HOTA&lt;br&gt;• Reprojection error (m) · team accuracy&lt;br&gt;• Ablations A1–A8" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="p9"><mxGeometry x="208" y="44" width="184" height="114" as="geometry"/></mxCell>
        <mxCell id="p9_opt" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Optimization&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• FP16 / ONNX / TensorRT&lt;br&gt;• Detector every k frames + Kalman&lt;br&gt;• Profiling: ms/frame, FPS" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="p9"><mxGeometry x="402" y="44" width="184" height="114" as="geometry"/></mxCell>
        <mxCell id="out" value="&lt;font style=&quot;font-size: 13px;&quot;&gt;&lt;b&gt;Deliverables&lt;/b&gt;&lt;/font&gt;&lt;br&gt;Demo video&lt;br&gt;Figures and tables&lt;br&gt;PDF report&lt;br&gt;Public repository" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;fontSize=12;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacingLeft=10;spacingRight=8;spacingTop=6;spacingBottom=6;" vertex="1" parent="1"><mxGeometry x="680" y="1376" width="200" height="172" as="geometry"/></mxCell>
        <mxCell id="legend" value="Legend" style="swimlane;fontStyle=1;fontSize=13;startSize=32;horizontal=1;container=1;collapsible=0;whiteSpace=wrap;html=1;rounded=1;arcSize=3;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;swimlaneFillColor=#fafafa;fontColor=#1a1a1a;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="40" y="1592" width="840" height="168" as="geometry"/></mxCell>
        <mxCell id="lg_chip0" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="16" y="42" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt0" value="Input / output" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="48" y="40" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip1" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="221" y="42" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt1" value="Preprocessing" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="253" y="40" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip2" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="426" y="42" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt2" value="Classical CV (pitch geometry)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="458" y="40" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip3" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="631" y="42" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt3" value="Deep learning (detect / track)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="663" y="40" width="168" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip4" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="16" y="68" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt4" value="Projection &amp;amp; analytics" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="48" y="66" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip5" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="221" y="68" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt5" value="Visualization &amp;amp; demo" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="253" y="66" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip6" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.5;" vertex="1" parent="legend"><mxGeometry x="426" y="68" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt6" value="Evaluation &amp;amp; optimization" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="458" y="66" width="170" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_chip7" value="" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;strokeWidth=1.5;dashed=1;dashPattern=8 4;" vertex="1" parent="legend"><mxGeometry x="631" y="68" width="26" height="16" as="geometry"/></mxCell>
        <mxCell id="lg_txt7" value="Optional (L4) · dashed border" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="663" y="66" width="168" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_line0" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeWidth=2;strokeColor=#333333;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="16" y="104" as="sourcePoint"/><mxPoint x="60" y="104" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg_ltxt0" value="Data flow" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="68" y="94" width="190" height="20" as="geometry"/></mxCell>
        <mxCell id="lg_line1" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeWidth=2;strokeColor=#B85450;dashed=1;dashPattern=6 4;" edge="1" parent="legend"><mxGeometry relative="1" as="geometry"><mxPoint x="266" y="104" as="sourcePoint"/><mxPoint x="310" y="104" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lg_ltxt1" value="Feedback loop (re-anchor)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#1a1a1a;" vertex="1" parent="legend"><mxGeometry x="318" y="94" width="190" height="20" as="geometry"/></mxCell>
